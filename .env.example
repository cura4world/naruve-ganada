# 프로브 하네스 설정. 이 파일을 .env로 복사해 채운다.
#
#   cp .env.example .env
#
# .env는 .gitignore에 있다. 절대 커밋하지 않는다.
# 셸에 export된 값이 .env보다 이긴다 — 일회성으로 다른 키를 쓸 때 유용하다.

# ---- Azure Speech (발음평가 + TTS) ----
# Azure Portal → Speech 리소스 → Keys and Endpoint
SPEECH_KEY=
SPEECH_REGION=koreacentral

# ---- TTS ----
# 어느 벤더로 음성을 만들지. elevenlabs | azure
# DECISIONS.md 8.5의 벤더 편향 측정을 하려면 둘 다 한 번씩 돌려야 한다.
TTS_VENDOR=elevenlabs

# ElevenLabs → Profile → API Key
# DECISIONS.md 9절: 유료 플랜에서 생성한 것이어야 한다.
# 무료 플랜 출력물은 상업 이용이 불가하다.
ELEVENLABS_API_KEY=

# ---- ETRI 발음평가 ----
# 스펙 미확인. scripts/adapters/etri.py의 TODO 참조.
# 실호출 전에 상업 이용 약관을 먼저 확인한다 (DECISIONS.md 8.2).
ETRI_API_KEY=

# ---- 선택 ----
# 비워 두면 스크립트의 기본값을 쓴다.
#ELEVENLABS_VOICE_ID=
#ELEVENLABS_MODEL=eleven_multilingual_v2
#AZURE_TTS_VOICE=ko-KR-SunHiNeural
# 음소 이름이 빈 문자열로 오는지가 (B)의 질문이다. 지정하면 결과가
# 달라질 수 있으므로 기본은 지정하지 않음이다. IPA로 한 번 더 돌려 비교한다.
#AZURE_PHONEME_ALPHABET=IPA
# 기본 엔진
#PROBE_ENGINE=azure
